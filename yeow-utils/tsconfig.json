{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": true,
    "paths": {
      "yeow-api": ["../yeow-api/src/index.ts"],
      "yeow-api/*": ["../yeow-api/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
