{
    "name": "yeow-doc-website",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Yeow documentation site (VitePress)",
    "scripts": {
        "setup:docs": "node scripts/setup-docs.mjs",
        "postinstall": "node scripts/setup-docs.mjs",
        "docs:zip": "node scripts/build-docs-zip.mjs",
        "dev": "vitepress dev .",
        "build": "node scripts/build-docs-zip.mjs && vitepress build .",
        "publish": "npm run build && node scripts/publish.mjs",
        "preview": "vitepress preview ."
    },
    "devDependencies": {
        "adm-zip": "^0.6.0",
        "vitepress": "^1.6.3"
    }
}
