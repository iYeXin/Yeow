{
    "name": "yeow-doc-website",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Yeow documentation site (VitePress)",
    "scripts": {
        "docs:zip": "node scripts/build-docs-zip.mjs",
        "dev": "vitepress dev vp-roots/cn",
        "dev:en": "vitepress dev vp-roots/en",
        "build:cn": "vitepress build vp-roots/cn",
        "build:en": "vitepress build vp-roots/en",
        "build": "node scripts/build-docs-zip.mjs && npm run build:cn && npm run build:en",
        "publish": "npm run build && node scripts/publish.mjs",
        "preview": "vitepress preview vp-roots/cn",
        "preview:en": "vitepress preview vp-roots/en"
    },
    "devDependencies": {
        "adm-zip": "^0.6.0",
        "vitepress": "^1.6.3"
    }
}
